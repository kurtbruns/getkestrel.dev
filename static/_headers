# Served by Workers Static Assets with the files in public/ (Hugo copies static/ there).
# The home page names /llms.txt for an agent that lands on it (issue #66), with the
# llmstxt.org relation. /docs answers through worker/index.js, so it's not set here.
/
  Link: </llms.txt>; rel="llms-txt"

# llms*.txt are UTF-8. In production the assets send a bare text/plain (wrangler dev adds
# the charset, so it doesn't show there), and a browser then reads "→" as "â†’". The .md
# copies get theirs from worker/index.js.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
