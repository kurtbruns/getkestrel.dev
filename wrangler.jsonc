{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getkestrel-dev",
  "compatibility_date": "2026-09-11",
  // workers_dev: false disables getkestrel-dev.kurtbruns.workers.dev so the
  // only crawlable production surface is the apex custom domain. PR preview
  // aliases (pr-<n>-<sha>-getkestrel-dev.kurtbruns.workers.dev) come from
  // preview_urls + `versions upload --preview-alias`, which is independent
  // of workers_dev and so still works.
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Production custom domains (issue #6 — Publish v1). custom_domain = true
  // makes `wrangler deploy` provision the proxied DNS record + edge cert and
  // serve getkestrel.dev from this worker, so a push to main goes live.
  // Requires getkestrel.dev to be an active zone in the Cloudflare account and
  // the deploy token to carry Workers + DNS edit scope.
  "routes": [
    { "pattern": "getkestrel.dev", "custom_domain": true },
    { "pattern": "www.getkestrel.dev", "custom_domain": true }
  ]
}
