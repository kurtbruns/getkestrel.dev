{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getkestrel-dev",
  "compatibility_date": "2026-09-11",
  // workers_dev: false disables getkestrel-dev.kurtbruns.workers.dev so the
  // only crawlable production surface is the apex custom domain. PR preview
  // aliases (pr-<n>-<sha>-getkestrel-dev.kurtbruns.workers.dev) come from
  // preview_urls + `versions upload --preview-alias`, which is independent
  // of workers_dev and so still works.
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Production custom domains. custom_domain = true lets wrangler manage the
  // proxied DNS record + edge cert. The www route exists so the dashboard's
  // www -> apex Redirect Rule has a target + cert to sit on top of. The DNS
  // cutover itself lives in the Publish issue (#6); these routes are here so
  // the first production deploy from main provisions the custom domains.
  "routes": [
    { "pattern": "getkestrel.dev", "custom_domain": true },
    { "pattern": "www.getkestrel.dev", "custom_domain": true }
  ]
}
